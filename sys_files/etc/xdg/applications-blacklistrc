# Applications that exist in the image but must not appear on the Plasma Bigscreen
# homescreen. Bigscreen's ApplicationListModel reads this file through KSharedConfig, which
# cascades over XDG_CONFIG_DIRS, unset in this image and therefore /etc/xdg. The same list
# feeds the apps grid, the Games row, the Recent row and the search overlay.
#
# Entries are desktop entry names: the .desktop basename with the suffix dropped. Not package
# names.
#
# Everything here is still installed and still launches from the fallback Plasma desktop.
# Hiding rather than uninstalling because removing a package takes its dependencies with it:
# dropping kde-connect made Bigscreen itself crash.
#
# kodi is on the list on purpose. Its stock launcher starts Kodi inside the Plasma session,
# where it gets no direct DRM access. atomc-kodi.desktop is the tile that ends the session and
# starts Kodi on GBM, and that one stays visible.

[Applications]
blacklist=fcitx5-configtool,firewall-config,kbd-layout-viewer5,kdesystemsettings,kodi,org.fcitx.Fcitx5,org.kde.ark,org.kde.discover,org.kde.dolphin,org.kde.drkonqi.coredump.gui,org.kde.filelight,org.kde.kate,org.kde.kcharselect,org.kde.kdebugsettings,org.kde.kdeconnect.app,org.kde.kdeconnect.nonplasma,org.kde.kdeconnect.sms,org.kde.kfind,org.kde.khelpcenter,org.kde.kinfocenter,org.kde.kjournaldbrowser,org.kde.kmenuedit,org.kde.konsole,org.kde.krfb,org.kde.kwalletmanager,org.kde.kwrite,org.kde.partitionmanager,org.kde.plasma-systemmonitor,org.kde.plasma-welcome,org.kde.plasma.emojier,org.kde.spectacle,plasma-bigscreen-swap-session,systemsettings
