[Unit]
Description=Pre-authorise the RemoteDesktop portal for the Bigscreen input handler
Documentation=https://invent.kde.org/plasma/plasma-bigscreen
# The entries have to exist before the input handler asks the portal for a session.
Before=default.target
ConditionPathExists=/usr/bin/plasma-bigscreen-inputhandler

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/atomc/atomc-seed-permissions

[Install]
WantedBy=default.target
