# Hand every input device to whoever owns the active session on the seat.
#
# Kodi on GBM opens the evdev nodes itself rather than receiving them from logind, so the
# account running it needs read access to /dev/input/event*, and it is not in the input group.
# systemd's 70-uaccess.rules covers input devices only when ID_INPUT_JOYSTICK is set, which
# leaves out the keyboards and IR remotes a TV uses.
#
# The number has to stay below 73. udev applies rule files in filename order and
# 73-seat-late.rules is what evaluates TAG=="uaccess", so a tag added after it lands in the
# udev database and never produces an ACL.
ACTION=="remove", GOTO="atomc_input_end"
SUBSYSTEM=="input", TAG+="uaccess"
LABEL="atomc_input_end"
