# Hand every input device to whoever owns the active session on the seat.
#
# Kodi built for GBM opens the evdev nodes itself instead of receiving them from logind the
# way a Wayland compositor does, so the account running it needs read access to
# /dev/input/event*. The installer's account is not in the input group and nothing else
# grants it.
#
# systemd ships uaccess for input devices only when ID_INPUT_JOYSTICK is set
# (70-uaccess.rules). Keyboards and IR remotes are not covered by that, which is exactly the
# set a TV needs.
#
# The number has to be below 73: 73-seat-late.rules is what evaluates TAG=="uaccess" and
# calls the uaccess builtin, and udev applies rule files in filename order. A tag added
# after 73 lands in the udev database and never produces an ACL.
ACTION=="remove", GOTO="atomc_input_end"
SUBSYSTEM=="input", TAG+="uaccess"
LABEL="atomc_input_end"
