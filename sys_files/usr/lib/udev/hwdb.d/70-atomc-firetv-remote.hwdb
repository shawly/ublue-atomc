# Amazon Fire TV Remote, 1st gen (Bluetooth HID, VID 1949 PID 0404)
#
# The hamburger button emits KEY_MENU (139), which xkbcommon turns into the keysym XF86MenuKB.
# Kodi's libinput backend has no mapping for that, so the press is dropped before any Kodi
# keymap sees it. It does map "Menu", the keysym for KEY_COMPOSE (127).
#
# c0040 is the HID Consumer Page usage "AC Menu" this remote reports alongside the key event,
# so the match does not depend on the xkb layout. Every other button already produces a keysym
# Kodi knows.
evdev:input:b0005v1949p0404*
 KEYBOARD_KEY_c0040=compose
