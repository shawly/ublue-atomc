// Let wheel members re-apply autologin without a password prompt, which a TV remote cannot
// type. Changing the autologin account takes a display manager restart to apply.
//
// Bazzite ships the same rule as bazzite-autologin.rules, without plasmalogin.service.
// Restarting atomc-autologin-setup.service alone does not apply a changed account, because
// it is a no-op once the config file exists.
polkit.addRule(function(action, subject) {
    if (subject.isInGroup("wheel") &&
        action.id == "org.freedesktop.systemd1.manage-units" &&
        (action.lookup("unit") == "atomc-autologin-setup.service" ||
         action.lookup("unit") == "plasmalogin.service"))
    {
        return polkit.Result.YES;
    }
})
