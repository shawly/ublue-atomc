# Applications that exist in the image but must not appear on the Plasma Bigscreen
# homescreen. Bigscreen's ApplicationListModel reads this list through KSharedConfig and it
# feeds the apps grid, the Games row, the Recent row and the search overlay.
#
# atomc-app-blacklist.service copies this file to ~/.config/applications-blacklistrc at every
# login. It cannot ship as /etc/xdg/applications-blacklistrc: plasma-bigscreen-envmanager
# writes its own blacklist key into ~/.config/plasma-bigscreen, which comes earlier in
# XDG_CONFIG_DIRS, and KConfig does not merge list entries across the cascade.
#
# Because this replaces the envmanager's value rather than adding to it, the entries it writes
# are repeated here. The waydroid ones name applications this image does not install.
#
# Entries are desktop entry names, the .desktop basename with the suffix dropped, not package
# names.
#
# kodi is on the list on purpose: its stock launcher starts Kodi inside the Plasma session,
# where it gets no direct DRM access. atomc-kodi.desktop is the tile that ends the session and
# starts Kodi on GBM, and that one stays visible.

[Applications]
blacklist=fcitx5-configtool,firewall-config,kbd-layout-viewer5,kdesystemsettings,kodi,org.fcitx.Fcitx5,org.kde.ark,org.kde.discover,org.kde.dolphin,org.kde.drkonqi.coredump.gui,org.kde.filelight,org.kde.kate,org.kde.kcharselect,org.kde.kdebugsettings,org.kde.kdeconnect.app,org.kde.kdeconnect.nonplasma,org.kde.kdeconnect.sms,org.kde.kfind,org.kde.khelpcenter,org.kde.kinfocenter,org.kde.kjournaldbrowser,org.kde.kmenuedit,org.kde.konsole,org.kde.krfb,org.kde.kwalletmanager,org.kde.kwrite,org.kde.partitionmanager,org.kde.plasma.emojier,org.kde.plasma-systemmonitor,org.kde.spectacle,plasma-bigscreen-swap-session,systemsettings,waydroid.com.android.calculator2,waydroid.com.android.camera2,waydroid.com.android.contacts,waydroid.com.android.deskclock,waydroid.com.android.documentsui,waydroid.com.android.gallery3d,waydroid.com.android.inputmethod.latin,waydroid.com.android.settings,waydroid.org.lineageos.eleven,waydroid.org.lineageos.etar,waydroid.org.lineageos.jelly,waydroid.org.lineageos.recorder
