#!/bin/bash
# Pre-authorise the XDG RemoteDesktop portal for plasma-bigscreen-inputhandler.
#
# The inputhandler has no uinput backend: every remote control and CEC key press goes through
# org.freedesktop.portal.RemoteDesktop, and without a stored permission the portal opens a
# consent dialog at session start that blocks the only input device that could dismiss it. The
# inputhandler calls preAuthorize() itself but has been seen prompting anyway on a fresh
# install.
#
# The entries are a permission the user can revoke in KDE's UI, so each app id is written once
# and then left alone. The record of what has been written lives in the user's state
# directory; an id missing from it is new, either a first login or one a later image added.

set -ouex pipefail

table=kde-authorized
id=remote-desktop

# Which app id the inputhandler presents to the portal is not known, so all three candidates
# are set. The empty one is the table's default entry.
app_ids=("" org.kde.plasma.bigscreen.inputhandler plasma-bigscreen-inputhandler)

stamp="${XDG_STATE_HOME:-${HOME}/.local/state}/atomc/seeded-permissions"

# flatpak permission-set will not create the db directory, and a user who has never run a
# flatpak does not have one.
mkdir -p "${XDG_DATA_HOME:-${HOME}/.local/share}/flatpak/db"

mkdir -p "${stamp%/*}"
touch "${stamp}"

for app_id in "${app_ids[@]}"; do
    key="${table} ${id} ${app_id}"

    if grep -qxF "${key}" "${stamp}"; then
        continue
    fi

    flatpak permission-set "${table}" "${id}" "${app_id}" yes
    printf '%s\n' "${key}" >>"${stamp}"
done
