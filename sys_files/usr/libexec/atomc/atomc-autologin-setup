#!/bin/bash
# Name the autologin account in /etc/plasmalogin.conf.d/.
#
# The installer creates the account, so the image cannot know the username. Session and
# Relogin ship as an image-owned default in /usr/lib/plasmalogin/plasmalogin.conf.d/, which
# leaves only User= to be resolved on the machine.
#
# The file is written only when it is absent, so a hand edit or a later
# `ujust set-autologin-user` survives reboots and image updates.

set -ouex pipefail

conf=/etc/plasmalogin.conf.d/10-atomc-autologin.conf

if [[ -e ${conf} ]]; then
    exit 0
fi

if ! user=$(/usr/libexec/atomc/atomc-primary-user); then
    echo "no local account with uid >= 1000, leaving autologin unconfigured" >&2
    exit 0
fi

mkdir -p "$(dirname "${conf}")"
cat > "${conf}" <<CONF
[Autologin]
User=${user}
CONF
