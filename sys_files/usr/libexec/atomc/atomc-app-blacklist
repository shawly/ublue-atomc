#!/bin/bash
# Install the homescreen blacklist into the user's config.
#
# It has to go under XDG_CONFIG_HOME, not /etc/xdg: plasma-bigscreen-common-env prepends
# ~/.config/plasma-bigscreen to XDG_CONFIG_DIRS and plasma-bigscreen-envmanager writes its own
# applications-blacklistrc there every session start, and KConfig takes a list entry whole from
# the highest priority file that defines it.
#
# Copying at every login rather than once is what carries a list extended by a later image to
# an account that already exists. The checksum of the last copy written distinguishes a target
# nobody has touched, which is replaced, from one the user has edited, which is left.

set -ouex pipefail

source=/usr/share/atomc/applications-blacklistrc
target="${XDG_CONFIG_HOME:-${HOME}/.config}/applications-blacklistrc"
stamp="${XDG_STATE_HOME:-${HOME}/.local/state}/atomc/app-blacklist.sha256"

if [[ -f ${target} && -f ${stamp} ]]; then
    written=$(<"${stamp}")
    current=$(sha256sum <"${target}")

    if [[ ${current} != "${written}" ]]; then
        # Leave the stamp alone too, so reverting the edit hands the file back to the image.
        exit 0
    fi
fi

mkdir -p "${target%/*}" "${stamp%/*}"
install -m 0644 "${source}" "${target}"
sha256sum <"${source}" >"${stamp}"
