#!/bin/bash
# Start the first login app picker.
#
# Flathub is configured as a system remote in /etc/flatpak/remotes.d, and a user
# installation does not inherit it. The picker installs with --user, because a system
# install needs org.freedesktop.Flatpak.app-install from polkit, which is a password
# prompt on a device driven by a remote. So the remote has to exist in the user
# installation before the picker can resolve a single ref.

set -ouex pipefail

# Qt 6 refuses XMLHttpRequest reads of file:// URLs unless this is set, and the picker
# reads its app list that way. The unit sets it too, for a run started by hand.
export QML_XHR_ALLOW_FILE_READ=1

# Not fatal. A machine that is not on the network yet still gets the picker, and each
# install reports its own failure on the row it belongs to.
flatpak remote-add --user --if-not-exists flathub /etc/flatpak/remotes.d/flathub.flatpakrepo ||
    echo "atomc-hello: could not add the flathub remote to the user installation" >&2

exec plasmawindowed org.kde.plasma.atomc.hello
