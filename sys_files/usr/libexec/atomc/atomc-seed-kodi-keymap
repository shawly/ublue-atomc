#!/bin/bash
# Seed the Fire TV remote keymap into the user's Kodi profile, without trampling their edits.
#
# Kodi's stock keyboard.xml already binds nine of the remote's eleven keys. The shipped file
# covers the two it does not: a long press of Home, which is the only way to reach a shutdown
# menu on a remote with no power button, and the Menu key inside the virtual keyboard. The
# Menu key additionally needs the hwdb remap in
# /usr/lib/udev/hwdb.d/70-atomc-firetv-remote.hwdb, without which the press never reaches the
# keymap layer.
#
# This runs at every login, so it has to distinguish a file it wrote itself from one the user
# has since changed. It records the hash of what it seeded and compares against that, not
# against the shipped file: comparing against the source would read every keymap seeded by an
# older image as a user edit, and a keymap fix could then never ship.

set -ouex pipefail

src=/usr/share/atomc/kodi-keymaps/firetv.xml
dest="${HOME}/.kodi/userdata/keymaps/firetv.xml"
stamp="${XDG_STATE_HOME:-${HOME}/.local/state}/atomc/kodi-keymap.sha256"

# Reading from stdin keeps the filename out of the output, so the two hashes are comparable.
shipped=$(sha256sum <"${src}" | cut -d ' ' -f 1)

if [[ -e ${dest} ]]; then
    current=$(sha256sum <"${dest}" | cut -d ' ' -f 1)
    seeded=$(cat "${stamp}" 2>/dev/null || true)

    if [[ ${current} == "${shipped}" ]]; then
        exit 0
    fi

    if [[ ${current} != "${seeded}" ]]; then
        echo "${dest} differs from the last seeded copy, leaving it alone" >&2
        exit 0
    fi
fi

# Kodi creates its profile on first launch, and this can run before that has ever happened,
# so the directories have to be created here. install -D covers both.
install -D -m 0644 "${src}" "${dest}"

mkdir -p "${stamp%/*}"
printf '%s\n' "${shipped}" >"${stamp}"
