#!/bin/bash
# Run agetty on the given tty, logged in as the primary user when there is one.
#
# The account is resolved at every getty start rather than written into a drop-in at first
# boot, so the console follows a later `ujust set-autologin-user` without a second unit
# having to rewrite anything.
#
# With no local account the fall-through is an ordinary login prompt. A rescue console that
# asks who you are still beats no console.

set -o pipefail

tty=$1
shift

user=$(/usr/libexec/atomc/atomc-primary-user) || user=""

if [[ -n ${user} ]]; then
    exec /usr/sbin/agetty --autologin "${user}" --noreset --noclear "${tty}" "$@"
fi

exec /usr/sbin/agetty --noreset --noclear "${tty}" "$@"
